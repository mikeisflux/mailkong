# ---- Core ----
NODE_ENV=development
PORT=3000
APP_URL=https://app.mailkong.net
ADMIN_URL=https://admin.mailkong.net
API_URL=https://api.mailkong.net
PLATFORM_DOMAIN=mailkong.net

# 32+ random bytes, base64. Rotating this invalidates all sessions.
SESSION_SECRET=
# Encrypts Postal credential secrets at rest. NEVER rotate without re-encrypting.
ENCRYPTION_KEY=

# ---- Datastores ----
DATABASE_URL=postgresql://mailkong:mailkong@localhost:5432/mailkong
REDIS_URL=redis://localhost:6379

# ---- Postal (Box B) ----
POSTAL_API_URL=https://postal.mailkong.net
# Staff-level Postal API key. Never exposed to customers.
POSTAL_API_KEY=
POSTAL_SMTP_HOST=smtp.mailkong.net
POSTAL_SMTP_PORT=587
POSTAL_DEFAULT_POOL=shared-tx

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Policy (see spec 14) ----
NEW_TENANT_DAILY_CAP=200
CLEAN_DAYS_BEFORE_RAISE=7
BOUNCE_RATE_PAUSE_THRESHOLD=0.08
COMPLAINT_RATE_PAUSE_THRESHOLD=0.001
SIGNUP_OPEN=false

# Comma-separated CIDRs allowed to reach /admin. Empty = allow all (dev only).
ADMIN_IP_ALLOWLIST=

# ---- On-call ----
# Where platform alerts are delivered. Point this at something OFF this
# infrastructure (PagerDuty, Slack, a phone) -- an outage that takes Postal
# down also takes the alert-email path down. Empty = email superadmins only.
ALERT_WEBHOOK_URL=
