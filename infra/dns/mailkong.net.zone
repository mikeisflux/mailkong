; Platform DNS for mailkong.net (spec section 3).
;
; Substitute before publishing:
;   BOX_A_IP     control plane  (app, admin, api, track)
;   BOX_B_IP     Postal         (postal, routes, rp)
;   SEND_IP_1    first sending address   -> mta1
;   SEND_IP_2    second sending address  -> mta2
;
; NOTHING under mta*, rp, routes or postal may be proxied through Cloudflare.
; Proxying breaks SMTP and hides the real address from PTR validation. Only
; app, admin, api and track may be orange-clouded.

$TTL 300

; -- control plane --------------------------------------------------------
app     IN A     BOX_A_IP
admin   IN A     BOX_A_IP
api     IN A     BOX_A_IP
track   IN A     BOX_A_IP
docs    IN A     BOX_A_IP
status  IN A     BOX_A_IP

; -- mail engine ----------------------------------------------------------
postal  IN A     BOX_B_IP
smtp    IN A     BOX_B_IP

; -- sending addresses; PTR must match these names exactly ----------------
mta1    IN A     SEND_IP_1
mta2    IN A     SEND_IP_2

; -- return path: collects bounces ----------------------------------------
rp      IN A     SEND_IP_1
rp      IN MX 10 postal.mailkong.net.
rp      IN TXT   "v=spf1 a mx include:spf.mailkong.net -all"

; -- inbound routing ------------------------------------------------------
routes  IN MX 10 postal.mailkong.net.

; -- the SPF include every customer domain points at ----------------------
; Adding a sending IP means editing this ONE record, not every customer's DNS.
spf     IN TXT   "v=spf1 ip4:SEND_IP_1 ip4:SEND_IP_2 -all"

; -- platform DMARC -------------------------------------------------------
; p=none while you establish a baseline. Tighten to quarantine once the
; aggregate reports are clean.
_dmarc  IN TXT   "v=DMARC1; p=none; rua=mailto:dmarc@mailkong.net; fo=1"

; -- abuse contact; a real monitored mailbox, not an alias to nowhere -----
abuse   IN MX 10 postal.mailkong.net.

; DKIM records are generated by Postal, per sending domain. Do not invent
; them and do not add them here.
